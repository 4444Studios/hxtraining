{
  "name": "hxtraining",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run server\" \"wait-on http://localhost:3005/health && vite\"",
    "build": "vite build",
    "server": "npx tsx --watch server/index.ts",
    "migration:create": "node --import tsx node_modules/@mikro-orm/cli/cli.js migration:create",
    "migration:up": "node --import tsx node_modules/@mikro-orm/cli/cli.js migration:up",
    "seed": "npx tsx server/seed.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@mikro-orm/core": "^6.6.6",
    "@mikro-orm/migrations": "^6.6.6",
    "@mikro-orm/postgresql": "^6.6.6",
    "@neondatabase/auth": "0.2.0-beta.1",
    "@supabase/supabase-js": "^2.95.2",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "lucide-react": "^0.563.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mikro-orm/cli": "^6.6.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}